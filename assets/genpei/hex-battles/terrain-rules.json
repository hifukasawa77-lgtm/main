{
  "version": 1,
  "cellSchema": {
    "required": ["q", "r", "terrain"],
    "optional": ["elevation", "objective", "deployment", "edgeBlocks"],
    "note": "Passability is determined from terrain data, never from background pixels."
  },
  "terrainTypes": {
    "plain":       { "land": true,  "naval": false, "moveCost": 1.0 },
    "road":        { "land": true,  "naval": false, "moveCost": 0.75 },
    "forest":      { "land": true,  "naval": false, "moveCost": 2.0, "lineOfSightPenalty": 1 },
    "hill":        { "land": true,  "naval": false, "moveCost": 2.0, "elevationBonus": 1 },
    "mountain":    { "land": true,  "naval": false, "moveCost": 3.0, "allowedUnits": ["infantry", "archer", "commander"] },
    "cliff":       { "land": false, "naval": false, "moveCost": null },
    "ravine":      { "land": false, "naval": false, "moveCost": null },
    "deep_river":  { "land": false, "naval": true,  "moveCost": 1.5 },
    "ford":        { "land": true,  "naval": true,  "moveCost": 2.5 },
    "bridge":      { "land": true,  "naval": false, "moveCost": 1.0 },
    "marsh":       { "land": true,  "naval": false, "moveCost": 2.5, "disallowedUnits": ["cavalry"] },
    "mudflat":     { "land": true,  "naval": false, "moveCost": 2.0, "tideSensitive": true },
    "shallow_sea": { "land": false, "naval": true,  "moveCost": 1.25 },
    "deep_sea":    { "land": false, "naval": true,  "moveCost": 1.0 },
    "fast_current":{ "land": false, "naval": true,  "moveCost": 2.0, "forcedDirection": true },
    "rocky_islet": { "land": false, "naval": false, "moveCost": null },
    "palisade":    { "land": false, "naval": false, "moveCost": null, "destructible": true },
    "gate":        { "land": true,  "naval": false, "moveCost": 1.5, "destructible": true }
  },
  "profiles": {
    "uji_byodoin":   { "impassable": ["deep_river", "cliff"], "special": ["bridge", "ford", "temple_objective"] },
    "ishibashiyama": { "impassable": ["cliff", "ravine", "deep_sea"], "highCost": ["forest", "mountain"], "special": ["fog_visibility"] },
    "fujigawa":      { "impassable": ["deep_river"], "highCost": ["marsh"], "special": ["ford", "camp_objective"] },
    "sunomata":      { "impassable": ["deep_river"], "special": ["ford", "night_visibility"] },
    "hiuchi_castle": { "impassable": ["cliff", "palisade", "deep_river"], "special": ["gate", "dam_objective"] },
    "kurikara_pass": { "impassable": ["cliff", "ravine"], "highCost": ["forest", "mountain"], "special": ["ambush_zone"] },
    "mizushima":     { "navalOnly": true, "impassable": ["rocky_islet"], "special": ["current", "boarding"] },
    "uji_river":     { "impassable": ["deep_river"], "special": ["bridge", "ford", "damaged_bridge"] },
    "awazu":         { "highCost": ["marsh", "snow_plain"], "special": ["breakout_route"] },
    "ichinotani":    { "impassable": ["cliff", "palisade", "deep_sea"], "highCost": ["forest", "mountain"], "special": ["gate", "steep_descent"] },
    "fujito":        { "impassable": ["deep_sea"], "highCost": ["mudflat", "marsh"], "special": ["hidden_ford", "tide"] },
    "yashima":       { "impassable": ["deep_sea", "palisade"], "highCost": ["marsh", "mountain"], "special": ["gate", "landing_beach", "tide"] },
    "dannoura":      { "navalOnly": true, "impassable": ["rocky_islet"], "highCost": ["fast_current"], "special": ["current_direction", "tide_change"] }
