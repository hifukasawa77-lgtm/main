<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 遮断したことをアプリ自身の通知で知らせる（任意機能）。Android 13+ で要求される。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 通話に関わるアプリなので、電話機能のない端末には配信しない。 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntlCallBlocker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IntlCallBlocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            着信スクリーニング。
            ROLE_CALL_SCREENING を保持している間だけ、呼び出し音が鳴る前に onScreenCall が届く。
            android:permission でシステム（Telecom）以外から束縛されないようにする。
        -->
        <service
            android:name=".service.IntlCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!--
            発信リダイレクト。
            ROLE_CALL_REDIRECTION を保持している間だけ、発信の直前に onPlaceCall が届く。
        -->
        <service
            android:name=".service.IntlCallRedirectionService"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
