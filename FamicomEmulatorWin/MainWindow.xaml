<Window x:Class="FamicomEmulatorWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Famicom Emulator Lab for Windows" Height="760" Width="1180" MinHeight="680" MinWidth="980"
        Background="#FF05070F" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Border" x:Key="GlassCard">
      <Setter Property="Background" Value="#B8131828" />
      <Setter Property="BorderBrush" Value="#4067E8F9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="#FFF8FAFC" />
      <Setter Property="BorderBrush" Value="#4067E8F9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock DockPanel.Dock="Left" Foreground="#FFF8FAFC" FontSize="28" FontWeight="Bold" Text="🕹️ Famicom Emulator Lab" />
      <TextBlock DockPanel.Dock="Right" Foreground="#FFA7B0C2" VerticalAlignment="Center" Text="NES / FDS Windows prototype" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*" />
        <ColumnDefinition Width=".95*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Foreground="#FF67E8F9" FontWeight="Bold" Text="ROM / FDS Loader" />
            <TextBlock Foreground="#FFA7B0C2" TextWrapping="Wrap" Margin="0,8,0,16" Text="自作ROMまたは正規に吸い出した .nes / .fds をローカルで読み込み、ヘッダー情報を解析します。市販ROMやFDS BIOSは同梱しません。" />
            <StackPanel Orientation="Horizontal">
              <Button Content="ROM/FDSを開く" Click="OpenRomClick" />
              <Button Content="デモに戻す" Click="ResetDemoClick" />
              <Button Content="1命令 Step" Click="StepCpuClick" />
              <Button Content="60命令 Run" Click="RunCpuClick" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}" Height="310">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Foreground="#FFF8FAFC" FontWeight="Bold" Margin="0,0,0,8" Text="解析ログ / Parse log" />
            <TextBox x:Name="LogBox" Background="#66000000" Foreground="#FFDDEAFE" BorderBrush="#20FFFFFF" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
          <TextBlock Foreground="#FFFACC15" TextWrapping="Wrap" Text="注意: FDS対応にはユーザーが用意したBIOS、2C33レジスタ、IRQタイマ、ディスク面切替、FDS音源の実装が必要です。このプロトタイプは解析・CPUコア基盤から段階的に育てる設計です。" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Foreground="#FF67E8F9" FontWeight="Bold" Text="PPU Preview 256×240" />
            <Border Background="#FF07111F" BorderBrush="#4067E8F9" BorderThickness="1" CornerRadius="14" Margin="0,10,0,12" Padding="8">
              <Image x:Name="ScreenImage" Stretch="Uniform" Width="512" Height="480" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <UniformGrid Columns="4">
              <StackPanel><TextBlock Foreground="#FF67E8F9" Text="CPU" /><TextBlock x:Name="CpuStatus" Foreground="#FFF8FAFC" Text="6502 core" /></StackPanel>
              <StackPanel><TextBlock Foreground="#FF67E8F9" Text="PPU" /><TextBlock Foreground="#FFF8FAFC" Text="256×240" /></StackPanel>
              <StackPanel><TextBlock Foreground="#FF67E8F9" Text="ROM" /><TextBlock x:Name="RomStatus" Foreground="#FFF8FAFC" Text="未読込" /></StackPanel>
              <StackPanel><TextBlock Foreground="#FF67E8F9" Text="FDS" /><TextBlock x:Name="FdsStatus" Foreground="#FFF8FAFC" Text="BIOS待ち" /></StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}" Height="220">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Foreground="#FFF8FAFC" FontWeight="Bold" Margin="0,0,0,8" Text="6502 Trace" />
            <TextBox x:Name="TraceBox" Background="#66000000" Foreground="#FFDDEAFE" BorderBrush="#20FFFFFF" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Foreground="#FFA7B0C2" Margin="8,14,8,0" Text="Roadmap: CPU Bus → PPU scanline → APU → Input → FDS BIOS/I/O → Compatibility tests" />
  </Grid>
</Window>
