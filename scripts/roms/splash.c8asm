; ============================================================
;  SPLASH — CHIP-8 タイトルデモ / title demo
;  hide_0001 portfolio 用のオリジナル ROM（著作権: 本リポジトリ）
;
;  "CHIP-8" のタイトルを描き、その下でボールを反射させ続ける。
;  DXYN の XOR 描画・DT によるフレーム同期・境界反射の最小デモ。
;
;  レジスタ / registers
;    V2 = ボール x   V3 = ボール y
;    V4 = ボール dx  V5 = ボール dy   (1 または 0xFF = -1)
;    V0,V1,V6 = scratch
; ============================================================

  ORG 0x200

BALL_MINX EQU 0
BALL_MAXX EQU 59
BALL_MINY EQU 14
BALL_MAXY EQU 27

start:
  CLS
  CALL draw_title
  LD V2, 30              ; ボール初期位置
  LD V3, 20
  LD V4, 1               ; dx = +1
  LD V5, 1               ; dy = +1

loop:
  LD I, ball
  DRW V2, V3, 4          ; 描画
  CALL wait2
  LD I, ball
  DRW V2, V3, 4          ; XOR で同じ場所を描いて消去
  ADD V2, V4
  ADD V3, V5

  SE V2, BALL_MINX       ; 左端で右向きへ
  JP chk_xmax
  LD V4, 1
chk_xmax:
  SE V2, BALL_MAXX       ; 右端で左向きへ
  JP chk_ymin
  LD V4, 0xFF
chk_ymin:
  SE V3, BALL_MINY       ; 上端（タイトルの下）で下向きへ
  JP chk_ymax
  LD V5, 1
chk_ymax:
  SE V3, BALL_MAXY       ; 下端で上向きへ
  JP loop
  LD V5, 0xFF
  JP loop

; --- 2フレーム待つ（DT は 60Hz で減る）---
wait2:
  LD V6, 2
  LD DT, V6
w2_loop:
  LD V6, DT
  SE V6, 0
  JP w2_loop
  RET

; --- "CHIP-8" を 4x5 文字で描く ---
draw_title:
  LD V1, 6               ; y
  LD V0, 17              ; x（6文字 * 5px = 30px を中央寄せ）
  LD I, ch_c
  DRW V0, V1, 5
  ADD V0, 5
  LD I, ch_h
  DRW V0, V1, 5
  ADD V0, 5
  LD I, ch_i
  DRW V0, V1, 5
  ADD V0, 5
  LD I, ch_p
  DRW V0, V1, 5
  ADD V0, 5
  LD I, ch_dash
  DRW V0, V1, 5
  ADD V0, 5
  LD V6, 8
  LD F, V6               ; "8" は内蔵フォントを使う
  DRW V0, V1, 5
  RET

; --- スプライトデータ（すべてコードの後ろに置く）---
ch_c:    DB 0xF0, 0x80, 0x80, 0x80, 0xF0
ch_h:    DB 0x90, 0x90, 0xF0, 0x90, 0x90
ch_i:    DB 0xE0, 0x40, 0x40, 0x40, 0xE0
ch_p:    DB 0xF0, 0x90, 0xF0, 0x80, 0x80
ch_dash: DB 0x00, 0x00, 0xF0, 0x00, 0x00
ball:    DB 0x60, 0xF0, 0xF0, 0x60
